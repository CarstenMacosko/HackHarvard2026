{
  "name": "@factory/droid-sdk",
  "version": "0.9.1",
  "private": false,
  "description": "TypeScript SDK for the Factory Droid CLI",
  "keywords": [
    "factory",
    "droid",
    "cli",
    "ai",
    "agent",
    "sdk"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "browser": {
    "ws": false
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Factory-AI/droid-sdk-typescript.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "eventemitter3": "^5.0.1",
    "fast-deep-equal": "^3.1.3",
    "isows": "^1.0.7",
    "uuid": "^9.0.0",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "homepage": "https://github.com/Factory-AI/droid-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/Factory-AI/droid-sdk-typescript/issues"
  }
}
