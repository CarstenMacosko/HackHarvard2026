/**
 * SDK MCP tool example.
 *
 * Defines an in-process tool with `createSdkMcpServer` + `tool` and exposes it
 * to Droid, then asks Droid to call it.
 *
 * Usage:
 *   npx tsx examples/node/sdk-mcp-tool.ts
 */

import { z } from 'zod';

import {
  DroidMessageType,
  ToolConfirmationOutcome,
  createSession,
  createSdkMcpServer,
  tool,
} from '@factory/droid-sdk/node';

const sdkTools = createSdkMcpServer({
  name: 'sdk-tools',
  tools: [
    tool(
      'favorite_number',
      'Returns a favorite number for a person',
      { name: z.string() },
      ({ name }) => `${name}'s favorite number is 42.`
    ),
  ],
});

const session = await createSession({
  mcpServers: [sdkTools],
  permissionHandler: () => ToolConfirmationOutcome.ProceedOnce,
});

try {
  for await (const message of session.stream(
    'Use the favorite_number tool for Ada and tell me the answer.'
  )) {
    if (message.type === DroidMessageType.ToolCall) {
      console.log(`[tool call] ${message.name}`);
    }
    if (message.type === DroidMessageType.Assistant) {
      console.log(message.text);
    }
    if (message.type === DroidMessageType.Result && !message.success) {
      throw new Error(
        message.error?.message ?? `Turn ended: ${message.subtype}`
      );
    }
  }
} finally {
  await session.close();
}
