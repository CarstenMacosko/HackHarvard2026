/**
 * Daemon connection from a browser: run a turn and approve its tool use.
 *
 * Waits for the turn to end rather than for the permission request, since a
 * turn can finish without asking.
 *
 * Runs in a real browser (no `process`, no Node builtins). From a source
 * checkout of this repository:
 *   npm run build
 *   FACTORY_API_KEY=... DROID_SDK_EXAMPLE_CWD=/repo npm run serve:browser-example
 *   open http://127.0.0.1:8420/?example=daemon-session
 *
 * Notes:
 * - If your page is served over https://, the browser will block ws:// URLs as
 *   mixed content. Use wss:// (or serve the page over http:// for localhost).
 * - Never commit a real API key or deploy it in browser code.
 */

import {
  AutonomyLevel,
  connectToDaemon,
  DroidMessageType,
  ToolConfirmationOutcome,
  type ConnectedDroidSession,
} from '@factory/droid-sdk';

const { daemonUrl, apiKey, cwd } = (
  globalThis as typeof globalThis & {
    __DROID_SDK_EXAMPLE_CONFIG__: {
      daemonUrl: string;
      apiKey: string;
      cwd: string;
    };
  }
).__DROID_SDK_EXAMPLE_CONFIG__;
if (!apiKey || !cwd) {
  throw new Error('Set FACTORY_API_KEY and DROID_SDK_EXAMPLE_CWD.');
}

const droid = await connectToDaemon({
  url: daemonUrl,
  auth: { apiKey },
});

let approvedPermission = false;
let session: ConnectedDroidSession | undefined;

try {
  session = await droid.sessions.create({
    cwd,
    // Off ensures even low-risk commands exercise the permission handler.
    autonomyLevel: AutonomyLevel.Off,
    permissionHandler: () => {
      approvedPermission = true;
      return ToolConfirmationOutcome.ProceedOnce;
    },
  });

  for await (const message of session.stream(
    'Run `echo hello from the browser example` and show me the output.'
  )) {
    if (message.type === DroidMessageType.Assistant) {
      console.log(message.text);
    }
  }

  if (!approvedPermission) {
    throw new Error('Turn finished without requesting permission.');
  }
} finally {
  await Promise.allSettled(session ? [session.close()] : []);
  droid.disconnect();
}
