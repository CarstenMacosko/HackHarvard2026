/**
 * Creates two sessions concurrently over one daemon connection.
 *
 * Runs in a real browser (no `process`, no Node builtins). From a source
 * checkout of this repository:
 *   npm run build
 *   FACTORY_API_KEY=... DROID_SDK_EXAMPLE_CWD=/repo npm run serve:browser-example
 *   open http://127.0.0.1:8420/?example=daemon-multi-session
 *
 * Never commit a real API key or deploy it in browser code.
 */

import {
  connectToDaemon,
  DroidMessageType,
  type ConnectedDroidSession,
} from '@factory/droid-sdk';

const { daemonUrl, apiKey, cwd } = (
  globalThis as typeof globalThis & {
    __DROID_SDK_EXAMPLE_CONFIG__: {
      daemonUrl: string;
      apiKey: string;
      cwd: string;
    };
  }
).__DROID_SDK_EXAMPLE_CONFIG__;
if (!apiKey || !cwd) {
  throw new Error('Set FACTORY_API_KEY and DROID_SDK_EXAMPLE_CWD.');
}

const droid = await connectToDaemon({
  url: daemonUrl,
  auth: { apiKey },
});

async function runTurn(
  session: ConnectedDroidSession,
  label: string,
  prompt: string
): Promise<void> {
  for await (const message of session.stream(prompt)) {
    if (message.type === DroidMessageType.Assistant) {
      console.log(`${label}: ${message.text}`);
    }
  }
}

const sessions: ConnectedDroidSession[] = [];
try {
  const first = await droid.sessions.create({ cwd });
  sessions.push(first);
  const second = await droid.sessions.create({ cwd });
  sessions.push(second);

  console.log(`First session:  ${first.id}`);
  console.log(`Second session: ${second.id}`);

  await Promise.all([
    runTurn(first, 'First', 'Say "one" and nothing else.'),
    runTurn(second, 'Second', 'Say "two" and nothing else.'),
  ]);
} finally {
  await Promise.allSettled(sessions.map((session) => session.close()));
  droid.disconnect();
}
