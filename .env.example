# =============================================================================
# Copy to .env.local for local dev. On Vercel, set the same keys under
# Project → Settings → Environment Variables (Production + Preview + Development).
# Never commit real secrets.
# =============================================================================

# --- Supabase (REQUIRED for durable Vercel deploys) ---
# Without these, the app falls back to in-memory demo: writes do not persist across
# serverless instances and auth redirects can loop.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must be the service_role secret (bypasses RLS). Do NOT put the anon key here.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL (optional; Vercel sets VERCEL_URL automatically) ---
WEB_URL=

# --- Anthropic (optional LLM assists for workflow builder) ---
ANTHROPIC_API_KEY=

# --- CV service (optional locally; recommended in production for server re-analysis) ---
CV_SERVICE_URL=
HAND_LANDMARKER_MODEL=
CV_CALLBACK_SECRET=

# --- Messaging agent callbacks (optional) ---
AGENT_URL=
AGENT_INTERNAL_SECRET=

# --- Factory Droid + Daytona (optional; /researcher/generate live mode) ---
FACTORY_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=
DROID_EXEC_PATH=

# --- Production guard (optional): fail boot if Supabase is missing ---
# VF_REQUIRE_SUPABASE=1
