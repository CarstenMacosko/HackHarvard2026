# --- Supabase (apps/web) — required for a durable Vercel deploy ---
# Leave blank only for local in-memory demo (data does not survive restarts / serverless).
NEXT_PUBLIC_SUPABASE_URL=
# web only: lets the browser upload a large video to a signed URL the server created
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-side only (web API routes). Bypasses row-level security: never commit or expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (optional LLM assists) ---
ANTHROPIC_API_KEY=

# --- CV service (required for production re-analysis of uploads) ---
# Deploy services/cv with `modal deploy modal_app.py`, then set the public URL here (and on Vercel).
CV_SERVICE_URL=
# services/cv: where the MediaPipe hand model lives (downloaded on first use if missing)
HAND_LANDMARKER_MODEL=
# Shared secret for /api/cv-callback (if the messaging agent posts analysed attempts)
CV_CALLBACK_SECRET=change-me

# --- Droid + Daytona module generation (required for live /researcher/generate on Vercel) ---
# Put these in the repo-root .env.local locally, and in Vercel → Environment Variables for production.
# Without them, generation falls back to template + local checks (no live Droid/Daytona).
FACTORY_API_KEY=
DAYTONA_API_KEY=
# Optional; defaults to https://app.daytona.io/api
DAYTONA_API_URL=
# Optional override for the droid binary (defaults to node_modules/.bin/droid from @factory/cli)
DROID_EXEC_PATH=
