# --- Supabase (apps/web, services/agent) ---
# Leave blank to run the web app on built-in demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (workflow builder, agent message wording) ---
ANTHROPIC_API_KEY=

# --- CV service (FastAPI on Modal/Railway) ---
CV_SERVICE_URL=http://localhost:8000
# Shared secret the CV service sends to /api/cv-callback
CV_CALLBACK_SECRET=change-me

# --- Photon 2.0 (services/agent) ---
PHOTON_API_KEY=
PHOTON_PHONE_NUMBER=
# dev = local stdin chat, photon = real Photon channel
AGENT_CHANNEL=dev
