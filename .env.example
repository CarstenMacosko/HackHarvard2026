# --- Supabase (apps/web, services/agent) --- schema and setup: docs/DATABASE.md
# Leave blank to run both on built-in demo data (in memory).
NEXT_PUBLIC_SUPABASE_URL=
# web only: lets the browser upload a large video to a signed URL the server created
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-side only (web API routes, agent). Bypasses row-level security: never commit or expose it.
SUPABASE_SERVICE_ROLE_KEY=
# the agent also accepts SUPABASE_URL instead of NEXT_PUBLIC_SUPABASE_URL

# --- Anthropic (optional LLM assists) ---
ANTHROPIC_API_KEY=

# --- CV service (FastAPI on Modal/Railway) ---
# Optional: when set, the web app re-runs every upload through the reference Python module.
# Leave blank to rely on on-device analysis only.
CV_SERVICE_URL=
# services/cv: where the MediaPipe hand model lives (downloaded on first use if missing)
HAND_LANDMARKER_MODEL=
# Shared secret the CV service sends to /api/cv-callback
CV_CALLBACK_SECRET=change-me

# --- Droid + Daytona module generation (/researcher/generate) ---
# Put these in the repo-root .env.local (next.config loads it for apps/web).
# Results are saved to droid_jobs + cv_models (no GitHub Actions).
# Without these keys the UI still runs end-to-end in demo mode (template + local sandboxes).
FACTORY_API_KEY=
DAYTONA_API_KEY=
# Optional; defaults to https://app.daytona.io/api
DAYTONA_API_URL=
# Optional override for the droid binary (defaults to node_modules/.bin/droid from @factory/cli)
DROID_EXEC_PATH=
