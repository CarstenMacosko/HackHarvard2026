# --- Supabase (apps/web, services/agent) --- schema and setup: docs/DATABASE.md
# Leave blank to run both on built-in demo data (in memory).
NEXT_PUBLIC_SUPABASE_URL=
# web only: lets the browser upload a large video to a signed URL the server created
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-side only (web API routes, agent). Bypasses row-level security: never commit or expose it.
SUPABASE_SERVICE_ROLE_KEY=
# the agent also accepts SUPABASE_URL instead of NEXT_PUBLIC_SUPABASE_URL

# --- Anthropic (workflow builder, agent message wording) ---
ANTHROPIC_API_KEY=

# --- CV service (FastAPI on Modal/Railway) ---
# Optional: when set, the web app re-runs every upload through the reference Python module.
# Leave blank to rely on on-device analysis only.
CV_SERVICE_URL=
# services/cv: where the MediaPipe hand model lives (downloaded on first use if missing)
HAND_LANDMARKER_MODEL=
# Shared secret the CV service sends to /api/cv-callback
CV_CALLBACK_SECRET=change-me

# --- Photon 2.0 (services/agent) ---
PHOTON_API_KEY=
PHOTON_PHONE_NUMBER=
# dev = local stdin chat, photon = real Photon channel
AGENT_CHANNEL=dev
# the scheduler always runs with photon; set to 1 to also run it in the dev chat (or type /tick)
AGENT_SCHEDULER=
# where the agent posts analysed attempts (/api/cv-callback)
WEB_URL=http://localhost:3000

# Droid model generation (optional): lets the workflow builder start .github/workflows/droid-model.yml.
# Fine-grained token for this repository: Actions read/write, Pull requests read, Contents read.
# The Factory API key is NOT set here; it is the FACTORY_API_KEY GitHub Actions secret (docs/DROID.md).
GITHUB_TOKEN=
GITHUB_REPOSITORY=carstenmacosko/hackharvard2026
DROID_WORKFLOW_REF=
